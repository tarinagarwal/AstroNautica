{
  "name": "@azaadawaaz/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-defaults": "node scripts/gen-defaults.mjs",
    "predev": "node scripts/gen-defaults.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-defaults.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:localnet": "node scripts/gen-defaults.mjs && vite build --mode localnet",
    "preview": "vite preview",
    "pretypecheck": "node scripts/gen-defaults.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/gen-defaults.mjs",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:real": "playwright test -c e2e-real/playwright.config.ts"
  },
  "dependencies": {
    "@azaadawaaz/contracts": "workspace:*",
    "@azaadawaaz/core": "workspace:*",
    "@azaadawaaz/media-strip": "workspace:*",
    "@azaadawaaz/schema": "workspace:*",
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-devanagari": "^5.2.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "blurhash": "^2.0.5",
    "hls.js": "^1.6.19",
    "libsodium-wrappers": "0.7.15",
    "markdown-it": "^14.1.0",
    "nostr-tools": "^2.17.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.0"
  }
}
