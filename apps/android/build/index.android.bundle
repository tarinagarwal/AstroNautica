__d(function(e,o,t,i,r,n,a){r.exports={"about.p1":"AzaadAwaaz is a news platform that can't be taken down. Invited contributors write stories; one moderator's approval publishes them.","about.p2":"Every published story is copied to several independent networks (IPFS, Arweave, Nostr relays) and gets a receipt on public blockchains. No single company, server or domain holds the only copy.","about.privacy":"No ads, no tracking, no analytics. The app talks only to the relays, gateways and chains on the signed lists, and to our API when you contribute. We don't record IP addresses.","about.privacyTitle":"Privacy","about.title":"About AzaadAwaaz","about.verify":"Every file is identified by its fingerprint (hash) and every story is signed. Press Verify on any story to see each check run live on this phone.","about.verifyTitle":"Check it yourself","banner.noLists":"No official lists found.","banner.noListsHelp":"This app couldn't load the signed lists of relays and gateways. Turn on Tor in Settings, or receive a story from another phone.","bundle.error.hash":"A file in the bundle was altered.","bundle.error.malformed":"The bundle is damaged.","bundle.error.manifest":"The story's manifest failed verification.","bundle.error.mismatch":"The bundle's contents don't match.","bundle.error.missingPart":"Part of the bundle is missing.","bundle.error.schema":"This is not an AzaadAwaaz story file.","bundle.error.signature":"The story is not signed by AzaadAwaaz's publisher.","bundle.error.tooLarge":"The bundle is too large.","bundle.error.unexpected":"The bundle contains files that don't belong to the story.","bundle.error.unzip":"The file couldn't be opened.","comments.chars":"{count} / {max}","comments.notAccepted":"No relay accepted it. Please try again later.","comments.replyingTo":"Replying to {id}\u2026","comments.unlockToPost":"Unlock the app to comment.","common.back":"Back","common.error":"Something went wrong","common.ok":"OK","common.refresh":"Refresh","contrib.changesRequested":"Changes requested:","contrib.draftMissing":"The draft isn't on this device, so it can't be edited here.","contrib.drafts":"Drafts on this device","contrib.editResubmit":"Edit and resubmit","contrib.feedbackUnreadable":"This feedback couldn't be decrypted with your key.","contrib.intro":"Write stories with text, photos and video. Metadata is removed from your media and everything is encrypted on this phone before it is uploaded.","contrib.inviteHelp":"New contributor? Open the invite link the owner sent you.","contrib.mine":"My submissions","contrib.new":"New story","contrib.noDrafts":"No drafts.","contrib.none":"You haven't submitted anything yet.","contrib.rejectedBecause":"Rejected. Reason:","contrib.title":"Contributor area","contrib.untitled":"Untitled","contrib.updated":"Updated {date}","contrib.version":"version {version}","contrib.view":"View","doh.help":"Without Tor, the app looks up addresses with encrypted DNS (DNS-over-HTTPS to Quad9, Cloudflare and Mullvad by IP address), so DNS blocking doesn't affect it.","editor.addEmbed":"+ Another story","editor.addGallery":"+ Images","editor.addImages":"Add images","editor.addText":"+ Text","editor.addVideo":"+ Video","editor.autosave":"Saved on this phone as you type. Nothing leaves it until you submit.","editor.block.embed-story":"Another story","editor.block.image":"Images","editor.block.text":"Text","editor.block.video":"Video","editor.blocks":"Story blocks","editor.caption":"Caption (optional)","editor.chooseVideo":"Choose a video (MP4 or MOV)","editor.correctionTitle":"Correction (version {version})","editor.cover":"Cover image","editor.embedId":"Story id","editor.embedVersion":"Version (optional; empty shows the latest)","editor.fixErrors":"Please fix these before submitting:","editor.keyCheck":"The server's encryption keys don't match the signed lists, so nothing was sent.","editor.lang.both":"Both","editor.lang.en":"English","editor.lang.hi":"Hindi","editor.language":"Story language","editor.location":"Location (optional)","editor.locationHelp":"Free text only, like a district or town. Never exact coordinates.","editor.markdown":"Text (Markdown: # heading, **bold**, *italic*, > quote, - list, [link](https://\u2026))","editor.metadataRemoved":"metadata removed \u2713","editor.penName":"Pen name (optional)","editor.privacy":"When you submit, the story and media are encrypted on this phone so only moderators can read them until one approves.","editor.problem.imageCount":"Block {n} needs between 1 and {max} images.","editor.problem.metadata":"A media file was not confirmed free of metadata.","editor.problem.mime":"This file type can't be used ({mime}).","editor.problem.noBlocks":"Add at least one block.","editor.problem.schema":"The story is incomplete.","editor.problem.storyId":"The story id is invalid.","editor.problem.tooLarge":"A file is larger than {mb} MB.","editor.problem.tooManyBlocks":"A story can have at most {max} blocks.","editor.problem.videoMissing":"Block {n} has no video yet.","editor.progress.done":"Submitted for review","editor.progress.encrypting":"Encrypting\u2026 {done}/{total}","editor.progress.uploading":"Uploading\u2026 {done}/{total}","editor.remove":"Remove","editor.storyTitle":"Title","editor.stripping":"Removing metadata on this phone\u2026","editor.submit":"Encrypt and submit for review","editor.summary":"Summary","editor.summaryHelp":"Up to 300 characters.","editor.tags":"Tags (separated by commas)","editor.tagsHelp":"Up to {max} tags.","editor.title":"New story","editor.uploadCover":"Choose a cover image","editor.useAsCover":"Use as cover","editor.videoChosen":"Video ready ({mb} MB)","editor.videoDescription":"Video description (optional)","editor.videoTitle":"Video title (optional)","embed.label":"Related story","embed.notFound":"This story couldn't be found.","home.empty":"No stories yet.","home.featured":"Featured","home.latest":"Latest","invite.backup":"Your contributor key is stored on this phone behind your app lock. If you lose the phone, ask the owner for a new invite.","invite.done":"Welcome! You can now write stories.","invite.expires":"Expires {date}","invite.help":"Paste the invite link or code the owner sent you. It is checked on this phone before anything is sent.","invite.invalid":"This invite can't be used: {error}","invite.link":"Invite link","invite.lockNote":"Contributors must set an app lock; you'll be asked to choose a PIN first.","invite.open":"Open an invite","invite.redeem":"Redeem invite","invite.title":"Invite","invite.valid":"This invite is signed by the owner.","keys.contributor":"Contributor key","keys.hide":"Hide","keys.locked":"Unlock the app to see your keys.","keys.manage":"Manage keys","keys.moderator":"Moderator key","keys.noReader":"No reader key yet. One is created the first time you comment or react.","keys.reader":"Reader key","keys.title":"Keys","keys.wipe":"Delete all keys","keys.wipeBody":"Every key on this phone will be deleted. This can't be undone.","keys.wipeTitle":"Delete keys","link.open":"Open","link.openBody":"This opens {url} in your browser, outside the app's Tor and encrypted DNS protection.","link.openTitle":"Open link?","lock.biometric":"Unlock with fingerprint or face","lock.biometricSubtitle":"Confirm it's you","lock.biometricTitle":"Unlock AzaadAwaaz","lock.changePin":"Change PIN","lock.enterPin":"Enter your PIN to unlock.","lock.locked":"Locked","lock.off":"No app lock is set.","lock.on":"The app is locked with a PIN.","lock.pin":"PIN (6\u201312 digits)","lock.pinAgain":"PIN again","lock.pinHelp":"The PIN protects the keys on this phone. Choose one you don't use elsewhere.","lock.pinMismatch":"The PINs don't match.","lock.readerNote":"Forgot your PIN? Reinstalling the app deletes all keys.","lock.remove":"Remove app lock","lock.required":"Required while contributor or moderator keys are on this phone.","lock.setPin":"Set a PIN","lock.title":"App lock","lock.unlock":"Unlock","lock.useBiometric":"Use fingerprint or face","lock.wait":"Too many attempts. Try again in {seconds} seconds.","lock.wrong":"Wrong PIN. {left} attempts left before a pause.","media.error.convert":"The image couldn't be converted.","media.error.empty":"The file is empty.","media.error.metadataLeft":"Metadata could not be fully removed, so the file was not added.","media.error.tooLarge":"The file is too large.","media.error.videoFormat":"Use an MP4 or MOV video.","media.unavailable":"This image couldn't be loaded from any source.","moderate.approve":"Approve and publish","moderate.auditPending":"Published to relays; the audit record failed ({error}).","moderate.bodyOk":"The decrypted story matches the submission.","moderate.claimedBy":"claimed by {who}","moderate.confirm.approve":"Approve?","moderate.confirm.changes":"Request changes?","moderate.confirm.reject":"Reject?","moderate.confirmBody.approve":"One approval publishes the story to every network. It can't be erased afterwards.","moderate.confirmBody.changes":"Your notes are encrypted to the contributor.","moderate.confirmBody.reject":"Rejection is final. Your reason is encrypted to the contributor.","moderate.decision":"Decision","moderate.decrypting":"Decrypting\u2026 {progress}","moderate.decryptingBody":"Decrypting the submission\u2026","moderate.done":"Done","moderate.empty":"The queue is empty.","moderate.feedback":"Reason or notes for the contributor","moderate.feedbackHelp":"Required to reject or request changes.","moderate.hide":"Hide","moderate.login":"Save moderator keys","moderate.loginHelp":"Enter your moderator secret key (nsec) and your X25519 encryption key. They are stored encrypted on this phone behind the app lock.","moderate.mediaMissing":"This file was not uploaded.","moderate.mute":"Mute","moderate.noWrap":"No key wrapped for you yet; another moderator's app adds it.","moderate.notListed":"This key is not on the signed moderator list.","moderate.nsec":"Secret key (nsec)","moderate.previewVideo":"Decrypt and preview video ({mb} MB)","moderate.problems":"Don't approve: the decrypted story doesn't match the submission.","moderate.queue":"Queue","moderate.reject":"Reject","moderate.requestChanges":"Request changes","moderate.review":"Review","moderate.submitted":"submitted {date}","moderate.synced":"Contributor lists updated (+{added}, revoked {revoked}); re-wrapped {rewrapped} submissions.","moderate.title":"Moderator area","moderate.unlist":"Unlist","moderate.unlistBody":"Official apps stop showing this story. Copies on public networks can't be erased, and the owner can reverse this.","moderate.unlistTitle":"Unlist this story?","moderate.x25519":"Encryption key (X25519, hex)","moderate.x25519Mismatch":"This encryption key doesn't match the one on the signed moderator list.","moderate.you":"you","nav.menu":"Menu","nav.receive":"Receive a story","nav.saved":"Saved stories","nav.settings":"Settings","net.check":"Check connections","net.checkResult":"Reachable directly: {relays}/{relaysTotal} relays, {gateways}/{gatewaysTotal} gateways.","offline.fromPhone":"from another phone","offline.help":"Saved stories and their videos stay on this phone and can be read without a connection.","offline.none":"Nothing saved yet.","offline.remove":"Remove","offline.save":"Save for offline","offline.saved":"Saved \u2713","p2p.permission":"Wi-Fi Direct needs the nearby devices (or location) permission.","p2p.progress":"Transferring\u2026 {percent}%","p2p.receive":"Receive over Wi-Fi Direct","p2p.receiveHelp":"Keep this screen open. The other phone chooses this one from its list.","p2p.send":"Send over Wi-Fi Direct","p2p.sendHelp":"Ask the other person to open Receive a story \u2192 Wi-Fi Direct, then choose their phone below.","p2p.sent":"Sent. The other phone checks every signature and hash before showing it.","p2p.title":"Wi-Fi Direct","p2p.unsupported":"This phone doesn't support Wi-Fi Direct. Share the file instead.","reach.apk":"Android app","reach.apkVersion":"Latest version: {version}","reach.app":"This app","reach.appHelp":"If our sites or servers are blocked, turn on Tor. It uses Snowflake or obfs4 bridges when Tor itself is blocked.","reach.intro":"AzaadAwaaz has many doors. If one is blocked, try another. Every copy can be checked with Verify.","reach.ipfs":"The website on IPFS","reach.mirrors":"Websites","reach.none":"None listed yet.","reach.offline":"Without internet","reach.offlineHelp":"Any story can be passed from phone to phone as a file or over Wi-Fi Direct; the receiving app checks it before showing it.","reach.onion":"Onion service (Tor Browser)","reach.onionHelp":"Open these addresses in Tor Browser.","reach.telegram":"Telegram","reach.telegramPending":"Our channel will be announced here.","receive.help":"Open a story file someone sent you, or receive one over Wi-Fi Direct. Nothing is shown until every signature and hash checks out.","receive.keep":"Open and keep","receive.missing":"{count} files were not included (for example the video).","receive.pick":"Open a story file","receive.title":"Receive a story","receive.verified":"Verified: original and unedited","receive.verifying":"Checking every signature and hash\u2026","search.label":"Search titles, summaries and tags","search.none":"No stories match.","share.build":"Prepare the story file","share.help":"Make a file with this story and everything needed to check it. Send it any way you like; the receiving app verifies it before showing it.","share.includeVideo":"Include videos","share.includeVideoHelp":"Videos make the file much larger.","share.ready":"The story file is ready.","share.saveFile":"Save the file","share.shareSheet":"Share\u2026","share.title":"Share offline","story.version":"version {version}","submission.state.approved":"Approved","submission.state.changes_requested":"Changes requested","submission.state.draft":"Draft","submission.state.in_review":"In review","submission.state.published":"Published","submission.state.publishing":"Publishing","submission.state.rejected":"Rejected","submission.state.submitted":"Submitted","submission.state.unlisted":"Unlisted","tor.auto":"Turn Tor on automatically when blocked","tor.autoHelp":"If no relay or gateway answers directly, the app switches to Tor by itself.","tor.autoOn":"Direct connections failed, so Tor was turned on.","tor.bridges":"Bridges (for when Tor is blocked)","tor.connecting":"Connecting to Tor\u2026 {percent}%","tor.help":"All the app's traffic (stories, videos, comments, uploads) goes through the built-in Tor.","tor.noBridges":"No bridge","tor.state.error":"Tor error","tor.state.off":"Tor off","tor.state.on":"Connected through Tor","tor.state.starting":"Connecting","tor.state.stopping":"Stopping","tor.title":"Blocked? Use Tor","tor.turnOff":"Turn Tor off","tor.useTor":"Use Tor","update.available":"Version {version} is available","update.cert":"Signing certificate","update.check":"Check for updates","update.download":"Download and check","update.downloading":"Downloading\u2026 {percent}%","update.error.cert":"The update is not signed with the expected certificate.","update.error.download":"The update couldn't be downloaded from any source.","update.error.package":"The downloaded file is a different app.","update.error.size":"The downloaded file has the wrong size.","update.error.version":"The downloaded file has the wrong version.","update.install":"Install","update.installed":"Installed: {version} ({code})","update.none":"You have the latest version.","update.openSettings":"Open settings","update.permissionBody":"Allow AzaadAwaaz to install apps, then press Install again.","update.permissionTitle":"Permission needed","update.title":"Updates","update.verified":"Checked: hash, size and signing certificate match the signed release list.","verify.again":"Check again","verify.arweave.no-gateway":"No Arweave gateway is listed.","verify.arweave.no-receipt":"No storage receipt yet (Arweave can finish after publication).","verify.arweave.unreachable":"The Arweave copy couldn't be reached.","verify.chainError.mismatch":"diff