__d(function(e,r,o,t,i,a,d){i.exports={"about.p1":"\u0906\u091c\u093c\u093e\u0926\u0906\u0935\u093e\u091c\u093c \u090f\u0915 \u0910\u0938\u093e \u0938\u092e\u093e\u091a\u093e\u0930 \u092e\u0902\u091a \u0939\u0948 \u091c\u093f\u0938\u0947 \u092c\u0902\u0926 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u092f\u094b\u0917\u0926\u093e\u0928\u0915\u0930\u094d\u0924\u093e \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0932\u093f\u0916\u0924\u0947 \u0939\u0948\u0902; \u0915\u093f\u0938\u0940 \u090f\u0915 \u092e\u0949\u0921\u0930\u0947\u091f\u0930 \u0915\u0940 \u092e\u0902\u091c\u093c\u0942\u0930\u0940 \u0938\u0947 \u0935\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964","about.p2":"\u0939\u0930 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0939\u093e\u0928\u0940 \u0915\u0908 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0928\u0947\u091f\u0935\u0930\u094d\u0915\u094b\u0902 (IPFS, Arweave, Nostr \u0930\u093f\u0932\u0947) \u092a\u0930 \u0915\u0949\u092a\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u092c\u094d\u0932\u0949\u0915\u091a\u0947\u0928 \u092a\u0930 \u0909\u0938\u0915\u0940 \u0930\u0938\u0940\u0926 \u092c\u0928\u0924\u0940 \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u090f\u0915 \u0915\u0902\u092a\u0928\u0940, \u0938\u0930\u094d\u0935\u0930 \u092f\u093e \u0921\u094b\u092e\u0947\u0928 \u0915\u0947 \u092a\u093e\u0938 \u0907\u0938\u0915\u0940 \u0905\u0915\u0947\u0932\u0940 \u0915\u0949\u092a\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964","about.privacy":"\u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u090f\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938 \u0928\u0939\u0940\u0902\u0964 \u0910\u092a \u0915\u0947\u0935\u0932 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0938\u0942\u091a\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0926\u093f\u090f \u0930\u093f\u0932\u0947, \u0917\u0947\u091f\u0935\u0947 \u0914\u0930 \u091a\u0947\u0928 \u0938\u0947, \u0914\u0930 \u092f\u094b\u0917\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0939\u092e\u093e\u0930\u0947 API \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0939\u092e IP \u092a\u0924\u0947 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964","about.privacyTitle":"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e","about.title":"\u0906\u091c\u093c\u093e\u0926\u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902","about.verify":"\u0939\u0930 \u092b\u093c\u093e\u0907\u0932 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0909\u0938\u0915\u0947 \u092b\u093c\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f (\u0939\u0948\u0936) \u0938\u0947 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0939\u0930 \u0915\u0939\u093e\u0928\u0940 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u0939\u093e\u0928\u0940 \u092a\u0930 \"\u091c\u093e\u0901\u091a\u0947\u0902\" \u0926\u092c\u093e\u090f\u0901 \u0914\u0930 \u0939\u0930 \u091c\u093e\u0901\u091a \u0907\u0938\u0940 \u092b\u093c\u094b\u0928 \u092a\u0930 \u091a\u0932\u0924\u0947 \u0939\u0941\u090f \u0926\u0947\u0916\u0947\u0902\u0964","about.verifyTitle":"\u0916\u093c\u0941\u0926 \u091c\u093e\u0901\u091a\u0947\u0902","banner.noLists":"\u0915\u094b\u0908 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0938\u0942\u091a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964","banner.noListsHelp":"\u0910\u092a \u0930\u093f\u0932\u0947 \u0914\u0930 \u0917\u0947\u091f\u0935\u0947 \u0915\u0940 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0938\u0942\u091a\u093f\u092f\u093e\u0901 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u093e\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 Tor \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902, \u092f\u093e \u0915\u093f\u0938\u0940 \u0926\u0942\u0938\u0930\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u0915\u0939\u093e\u0928\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964","bundle.error.hash":"\u092c\u0902\u0921\u0932 \u0915\u0940 \u0915\u094b\u0908 \u092b\u093c\u093e\u0907\u0932 \u092c\u0926\u0932\u0940 \u0917\u0908 \u0939\u0948\u0964","bundle.error.malformed":"\u092c\u0902\u0921\u0932 \u0916\u093c\u0930\u093e\u092c \u0939\u0948\u0964","bundle.error.manifest":"\u0915\u0939\u093e\u0928\u0940 \u0915\u093e \u092e\u0948\u0928\u093f\u092b\u093c\u0947\u0938\u094d\u091f \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964","bundle.error.mismatch":"\u092c\u0902\u0921\u0932 \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0940\u0964","bundle.error.missingPart":"\u092c\u0902\u0921\u0932 \u0915\u093e \u090f\u0915 \u0939\u093f\u0938\u094d\u0938\u093e \u0917\u093c\u093e\u092f\u092c \u0939\u0948\u0964","bundle.error.schema":"\u092f\u0939 \u0906\u091c\u093c\u093e\u0926\u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","bundle.error.signature":"\u0915\u0939\u093e\u0928\u0940 \u0906\u091c\u093c\u093e\u0926\u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964","bundle.error.tooLarge":"\u092c\u0902\u0921\u0932 \u092