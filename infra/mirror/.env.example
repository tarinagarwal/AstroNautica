# AzaadAwaaz mirror settings. Copy to infra/mirror/.env (git-ignored).

# REQUIRED: the owner's public key (npub1... or 64 hex). Get it from the
# "How to reach us" page and check it against a second source.
OWNER_PUBKEY=

# Where to start: official relays (comma-separated full URLs) and gateways.
# mirror-sync replaces these with the signed relay/gateway lists once verified.
UPSTREAM_RELAYS=wss://relay.azaadawaaz.org
BOOTSTRAP_GATEWAYS=https://ipfs.azaadawaaz.org,https://dweb.link

SYNC_INTERVAL_SECONDS=600

# Host ports
WEB_PORT=80
RELAY_PORT=7777
IPFS_GATEWAY_PORT=8080
IPFS_SWARM_PORT=4001

IPFS_STORAGE_MAX=200GB
# Optional fixed peering with the official IPFS nodes, JSON:
# [{"ID":"12D3Koo...","Addrs":["/dns4/ipfs.azaadawaaz.org/tcp/4001"]}]
IPFS_PEERING=

# Relay write policy for comments/reactions sent directly to this mirror.
POW_DIFFICULTY=16
RATE_COMMENTS_PER_MINUTE=10
RATE_REACTIONS_PER_MINUTE=60
MAX_COMMENT_CHARS=2000
