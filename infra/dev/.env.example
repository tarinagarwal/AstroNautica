# AzaadAwaaz dev network settings. Copy to infra/dev/.env (git-ignored) and
# edit; docker compose reads it automatically when run with
#   docker compose -f infra/dev/docker-compose.yml ...
# Every value below is the default, so the file is optional.

# --- Relay write policy (spec §7) ---
# NIP-13 difficulty required on comments (kind 1111) and reactions (kind 7).
# 0 disables proof-of-work (handy for very slow test machines).
POW_DIFFICULTY=16
RATE_COMMENTS_PER_MINUTE=10
RATE_REACTIONS_PER_MINUTE=60
MAX_COMMENT_CHARS=2000

# --- Host ports (all bound to 127.0.0.1) ---
RELAY_A_PORT=7777
RELAY_B_PORT=7778
IPFS_A_API_PORT=5001
IPFS_A_GATEWAY_PORT=8080
IPFS_B_API_PORT=5002
IPFS_B_GATEWAY_PORT=8081
POSTGRES_PORT=5432
ARLOCAL_PORT=1984
ANVIL_PORT=8545
ANVIL_BSC_PORT=8546

# --- PostgreSQL: DEV ONLY credentials, never reuse anywhere else ---
POSTGRES_DB=azaadawaaz
POSTGRES_USER=azaad
POSTGRES_PASSWORD=azaad
# Connection strings the services and tests use:
#   DATABASE_URL=postgres://azaad:azaad@127.0.0.1:5432/azaadawaaz
#   TEST_DATABASE_URL=postgres://azaad:azaad@127.0.0.1:5432/azaadawaaz_test
