# AzaadAwaaz production settings for one host. Copy to infra/prod/.env
# (git-ignored). Secrets do NOT go here: they are files in ./secrets/ (see
# secrets/README.md), mounted as Docker secrets.

# Image tag for the locally built images.
RELEASE=latest

# --- Relay write policy (spec §7) ---
POW_DIFFICULTY=16
RATE_COMMENTS_PER_MINUTE=10
RATE_REACTIONS_PER_MINUTE=60
MAX_COMMENT_CHARS=2000

# --- Publisher ---
ARWEAVE_URL=https://arweave.net
# chainId=rpcUrl, comma-separated (decisions.md D7: Base and BNB Smart Chain).
EVM_RPC_URLS=8453=https://mainnet.base.org,56=https://bsc-dataseed.bnbchain.org
# chainId=AzaadAwaazRegistry address, comma-separated (filled in after deployment).
REGISTRY_ADDRESSES=8453=0x0000000000000000000000000000000000000000,56=0x0000000000000000000000000000000000000000
# Our relays and IPFS nodes on the other hosts (the local ones are added automatically).
EXTRA_RELAYS=wss://relay.azaadawaaz.net
EXTRA_IPFS_API_URLS=

# --- IPFS ---
IPFS_STORAGE_MAX=500GB
# Fixed peering with our other IPFS nodes and approved mirrors, JSON:
# [{"ID":"12D3Koo...","Addrs":["/dns4/ipfs.azaadawaaz.net/tcp/4001"]}]
IPFS_PEERING=
