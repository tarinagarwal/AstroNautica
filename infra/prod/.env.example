# AzaadAwaaz production settings for one host. Copy to infra/prod/.env
# (git-ignored). Secrets do NOT go here: they are files in ./secrets/ (see
# secrets/README.md), mounted as Docker secrets.

# Image tag for the locally built images.
RELEASE=latest

# --- Relay write policy (spec §7) ---
POW_DIFFICULTY=16
RATE_COMMENTS_PER_MINUTE=10
RATE_REACTIONS_PER_MINUTE=60
MAX_COMMENT_CHARS=2000

# --- Trust anchor ---
# The owner's public key (npub or hex), from the key ceremony (docs/runbooks/owner-key-ceremony.md).
OWNER_PUBKEY=

# --- API ---
# Every URL clients use to reach the API, comma-separated, all with the same path (nginx serves it under /api).
API_PUBLIC_URLS=https://azaadawaaz.org/api,https://azaadawaaz.news/api,https://azaadawaaz.net/api
# Browser origins allowed to call the API (the web app's doors).
WEB_ORIGINS=https://azaadawaaz.org,https://azaadawaaz.news,https://azaadawaaz.net

# --- Publisher ---
ARWEAVE_URL=https://arweave.net
# Full videos go to Arweave only up to this many bytes (0 = never; owner decision on budget, spec §17 Q2).
ARWEAVE_MAX_VIDEO_BYTES=0
# Receipt chains (decisions.md D7). Fill in the registry addresses after deploying packages/contracts.
CHAINS_JSON=[{"key":"base","chainId":8453,"rpc":"https://mainnet.base.org","registry":"0x0000000000000000000000000000000000000000"},{"key":"bsc","chainId":56,"rpc":"https://bsc-dataseed.bnbchain.org","registry":"0x0000000000000000000000000000000000000000"}]
# Public gateways serving our content, used as torrent web seeds.
PUBLIC_IPFS_GATEWAYS=https://ipfs.azaadawaaz.org,https://ipfs.azaadawaaz.net
REQUIRED_RELAY_SUCCESSES=3
# Our relays and IPFS nodes on the other hosts (the local ones are added automatically).
EXTRA_RELAYS=wss://relay.azaadawaaz.net
EXTRA_IPFS_API_URLS=

# --- IPFS ---
IPFS_STORAGE_MAX=500GB
# Fixed peering with our other IPFS nodes and approved mirrors, JSON:
# [{"ID":"12D3Koo...","Addrs":["/dns4/ipfs.azaadawaaz.net/tcp/4001"]}]
IPFS_PEERING=
