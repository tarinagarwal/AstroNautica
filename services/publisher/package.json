    "magnet-uri": "^7.0.10",
    "nostr-tools": "^2.25.2",
    "pg": "^8.23.1",
    "viem": "^2.57.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
