# services/api configuration. Every variable is optional in development when .dev/config.json exists
# (written by scripts/dev-setup.mjs); environment variables always win.

# HTTP
PORT=8787
# 127.0.0.1 for local runs; the Docker image sets 0.0.0.0.
HOST=127.0.0.1
# The base URL(s) clients use to reach the API. NIP-98 `u` tags must equal one of these + path + query.
# Comma-separate several doors (domains, onion); all must share the same path (e.g. /api behind nginx).
PUBLIC_URL=http://127.0.0.1:8787
# Browser origins allowed by CORS (never a wildcard; no credentials).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
DATABASE_URL=postgres://azaad:azaad@127.0.0.1:5432/azaadawaaz
# Alternatively (docker secrets): DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD_FILE
STAGING_DIR=.dev/staging
# Apply migrations on start (set to false to run `pnpm --filter @azaadawaaz/api migrate` separately).
AUTO_MIGRATE=true

# Trust anchors
# The pinned owner key (npub or hex).
OWNER_PUBKEY=
# Relays to load the signed lists from (and to forward audit events to when no own relay is listed).
RELAYS=ws://127.0.0.1:7777,ws://127.0.0.1:7778
# Optional: a JSON array of signed list events to load at start (works offline).
BOOTSTRAP_LIST_EVENTS=
LISTS_REFRESH_SECONDS=30

# Moderation
CLAIM_MINUTES=30
UNLIST_PER_HOUR=5
SUBMISSIONS_PER_HOUR=30
REJECTED_RETENTION_DAYS=30
# draft / changes_requested submissions not updated for this many days expire (staging and ciphertext deleted).
DRAFT_RETENTION_DAYS=30
CLEANUP_INTERVAL_MINUTES=60

# Limits (bytes, or with a binary suffix: 20MB = 20 MiB)
MAX_IMAGE_BYTES=20MB
MAX_VIDEO_BYTES=2GB
MAX_BLOCKS=100
MAX_MEDIA_PER_SUBMISSION=200
# Total declared media bytes per submission, and per contributor across submissions still in progress.
MAX_SUBMISSION_BYTES=4GB
MAX_CONTRIBUTOR_STAGING_BYTES=8GB
MAX_JSON_BYTES=8MB

LOG_LEVEL=info
